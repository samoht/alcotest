(env
 (dev
  (flags :standard %{dune-warnings})))

(mdx
 (files README.md)
 (deps
  examples/simple.exe
  examples/with_args/main.exe
  test/e2e/strip_randomness.exe))

(rule
 (progn
  (copy examples/simple.exe test.exe)
  (with-stdout-to
   alcotest-help.txt.actual
   (run ./test.exe --help=plain))))

(rule
 (alias runtest)
 (action
  (diff alcotest-help.txt alcotest-help.txt.actual)))
